{
    "name": "@codemind.ec/medusa-plugin-contifico",
    "description": "Medusa v2 plugin for Contifico ERP integration — product sync, stock management, customer mapping, and electronic invoicing for Ecuador.",
    "version": "1.1.0",
    "author": "Kollor <dev@codemind.ec> (https://codemind.ec)",
    "license": "MIT",
    "exports": {
        "./package.json": "./package.json",
        "./contifico": "./.medusa/server/src/modules/contifico/index.js",
        "./modules/contifico": "./.medusa/server/src/modules/contifico/index.js",
        "./modules/*": "./.medusa/server/src/modules/*/index.js",
        "./.medusa/server/src/modules/*": "./.medusa/server/src/modules/*/index.js",
        "./workflows": "./.medusa/server/src/workflows/index.js",
        "./admin": {
            "import": "./.medusa/server/src/admin/index.mjs",
            "require": "./.medusa/server/src/admin/index.js",
            "default": "./.medusa/server/src/admin/index.js"
        }
    },
    "scripts": {
        "build": "medusa plugin:build",
        "dev": "medusa plugin:develop",
        "test": "vitest run",
        "prepublishOnly": "medusa plugin:build"
    },
    "devDependencies": {
        "@medusajs/admin-sdk": "2.21.2",
        "@medusajs/admin-shared": "2.21.2",
        "@medusajs/cli": "2.21.2",
        "@medusajs/framework": "2.21.2",
        "@medusajs/icons": "^2.21.2",
        "@medusajs/medusa": "2.21.2",
        "@medusajs/test-utils": "2.21.2",
        "@medusajs/ui": "^4.2.6",
        "@swc/core": "1.16.2",
        "@types/node": "^20.19.43",
        "@types/react": "^18.3.31",
        "@types/react-dom": "^18.3.7",
        "prop-types": "^15.8.1",
        "react": "^18.3.1",
        "react-dom": "^18.3.1",
        "ts-node": "^10.9.2",
        "typescript": "^5.9.3",
        "vite": "^7.3.6",
        "vitest": "^3.2.7",
        "yalc": "^1.0.0-pre.53"
    },
    "engines": {
        "node": ">=20"
    },
    "files": [
        ".medusa/server"
    ],
    "keywords": [
        "medusa",
        "medusa-plugin",
        "medusa-v2",
        "plugin",
        "contifico",
        "erp",
        "ecuador",
        "codemind",
        "kollor"
    ],
    "packageManager": "pnpm@9.15.9",
    "peerDependencies": {
        "@medusajs/admin-sdk": "^2.13.3",
        "@medusajs/admin-shared": "^2.13.3",
        "@medusajs/cli": "^2.13.3",
        "@medusajs/framework": "^2.13.3",
        "@medusajs/icons": "^2.13.3",
        "@medusajs/medusa": "^2.13.3",
        "@medusajs/test-utils": "^2.13.3",
        "@medusajs/ui": "^4.1.3"
    }
}
